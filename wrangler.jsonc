{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financexai-project",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TimesFMContainer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["TimesFMContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
